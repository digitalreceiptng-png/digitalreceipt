{
  "name": "digitalreceipt-desktop",
  "version": "1.0.0",
  "description": "DigitalReceipt.ng Desktop App for Windows",
  "main": "main.js",
  "author": "DigitalReceipt.ng",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . DigitalReceipt --platform=win32 --arch=x64 --icon=assets/icon.ico --out=dist --overwrite --asar",
    "build:mac": "electron-packager . DigitalReceipt --platform=darwin --arch=x64,arm64 --icon=assets/icon.icns --out=dist --overwrite --asar",
    "dist": "electron-builder --win --x64 --ia32",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-packager": "^17.1.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ng.digitalreceipt.desktop",
    "productName": "DigitalReceipt",
    "asar": false,
    "files": [
      "main.js",
      "index.html",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.finance"
    },
    "dmg": {
      "artifactName": "DigitalReceipt-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DigitalReceipt",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "artifactName": "DigitalReceipt-Setup.${ext}"
  }
}
